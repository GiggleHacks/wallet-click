{
  "name": "wallet-click",
  "version": "1.18.0",
  "description": "Get paid in BTC, ETH or XMR at a fresh or permanent address; FixedFloat swaps it to USDC on Base (optionally through Monero, after a wait, in pieces) and sends it to your exchange",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "wallet:init": "node dist/server/cli/wallet-init.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@scure/btc-signer": "^2.0.1",
    "fastify": "^5.12.5",
    "motion": "^14.1.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
