# Copy to .env and fill in.

# Login password (8+ characters, pasting is fine). Required.
APP_PASSWORD=

# FixedFloat API key and secret (ff.io > API management). Required to create addresses.
FF_API_KEY=
FF_API_SECRET=

# Where every swap pays out: your Coinbase USDT deposit address on Ethereum (ERC-20).
# Defaults to the built-in address; the server refuses to start if the checksum is wrong.
# PAYOUT_ADDRESS=0x7E577e577e577E577e577E577E577E577e577E57

# Only answer requests for these hostnames (comma separated). Blocks DNS-rebinding tricks.
# ALLOWED_HOSTS=myvps.tail1234.ts.net

# Cookie "Secure" flag: auto (when served over HTTPS), true, or false
# COOKIE_SECURE=auto
# "Remember this device" sign-ins last this many days (renewed while used)
# REMEMBER_DAYS=365
# Without "remember", a sign-in ends after this many hours or when the browser closes
# SESSION_HOURS=12

# Local (non-Docker) runs only
# HOST=127.0.0.1
# PORT=8787
# DATA_DIR=./data

# Docker only: the localhost port the server listens on (host networking; 8787 if unset)
# WC_PORT=8787

# ---------------------------------------------------------------- Monero, Privacy Enhanced, permanent addresses

# The VPS's monero-wallet-rpc. Unset = Privacy Enhanced and permanent Monero addresses are off.
# Wallet Click keeps to its own account in that wallet ("wallet-click"; never account 0).
# MONERO_RPC_URL=http://127.0.0.1:18083/json_rpc
# Only if monero-wallet-rpc runs with --rpc-login user:password (recommended):
# MONERO_RPC_USER=
# MONERO_RPC_PASSWORD=

# Unlocks the Bitcoin/Ethereum hot wallet (data/wallet.enc) for permanent BTC/ETH addresses.
# Make one with `openssl rand -hex 32`, then run `npm run wallet:init` once (Docker:
# `docker compose exec wallet-click node dist/server/cli/wallet-init.js`) and restart.
# The 24 words land in data/seed-backup.txt: write them down, then delete that file.
# WALLET_KEY=

# Testing only: every wait is this many minutes instead of the chosen hours, and pieces are seconds apart.
# PRIVACY_TEST_DELAY_MIN=10
