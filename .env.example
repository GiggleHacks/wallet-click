# Copy to .env and fill in.

# Login password (8+ characters, pasting is fine). Required.
APP_PASSWORD=

# FixedFloat API key and secret (ff.io > API management). Required to create addresses.
FF_API_KEY=
FF_API_SECRET=

# Where every swap pays out: your Coinbase USDT deposit address on Ethereum (ERC-20).
# Defaults to the built-in address; the server refuses to start if the checksum is wrong.
# PAYOUT_ADDRESS=0x7E577e577e577E577e577E577E577E577e577E57

# Only answer requests for these hostnames (comma separated). Blocks DNS-rebinding tricks.
# ALLOWED_HOSTS=myvps.tail1234.ts.net

# Cookie "Secure" flag: auto (when served over HTTPS), true, or false
# COOKIE_SECURE=auto
# "Remember this device" sign-ins last this many days (renewed while used)
# REMEMBER_DAYS=365
# Without "remember", a sign-in ends after this many hours or when the browser closes
# SESSION_HOURS=12

# Local (non-Docker) runs only
# HOST=127.0.0.1
# PORT=8787
# DATA_DIR=./data

# Docker only: the localhost port on the host (the container always listens on 8787)
# WC_PORT=8787
